# ============================================================================
# QuantoDeu API — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env.
# Gere segredos com: openssl rand -base64 48
# ============================================================================

# --- Aplicação ---------------------------------------------------------------
# development | production
APP_ENV=development
APP_VERSION=1.2.0
# fuso para "hoje" e fechamento de mês
APP_TIMEZONE=America/Sao_Paulo
# debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT=text                   # apenas em development

# --- HTTP ------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_MAX_BODY_BYTES=1048576
# front-end; nunca "*" (o próprio Swagger em /docs já é permitido)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# IPs/CIDRs do reverse proxy (ex.: 10.0.0.0/8)
TRUSTED_PROXIES=
# Swagger em /docs (padrão: desligado em produção)
DOCS_ENABLED=true

# --- PostgreSQL --------------------------------------------------------------
# No docker-compose estas URLs são montadas automaticamente a partir das
# variáveis abaixo. Rodando fora do Docker, preencha manualmente:
#   DATABASE_URL           -> usuário da API (membro de quantodeu_app, sujeito a RLS)
#   DATABASE_MIGRATION_URL -> dono das tabelas (roda as migrations)
DATABASE_URL=postgres://quantodeu_api:troque-app-db@localhost:5432/quantodeu?sslmode=disable
DATABASE_MIGRATION_URL=postgres://quantodeu:quantodeu@localhost:5432/quantodeu?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_RUN_MIGRATIONS=true
# recusa subir se a role da API ignorar Row-Level Security
DB_REQUIRE_RLS=true

# dono das tabelas (compose)
POSTGRES_USER=quantodeu
POSTGRES_PASSWORD=quantodeu
POSTGRES_DB=quantodeu
# usuário da API (criado por deploy/postgres/init)
APP_DB_USER=quantodeu_api
APP_DB_PASSWORD=troque-app-db

# --- Sessão ------------------------------------------------------------------
# postgres | redis
SESSION_STORE=postgres
SESSION_COOKIE_NAME=__Host-quantodeu_session
# expiração absoluta (7 dias)
SESSION_TTL=168h
# expiração por inatividade
SESSION_IDLE_TIMEOUT=72h
SESSION_CLEANUP_PERIOD=1h
# Rotação: coloque a NOVA chave primeiro e mantenha a antiga até o TTL expirar.
SESSION_SECRETS=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# --- Redis -------------------------------------------------------------------
# Usado quando SESSION_STORE, RATE_LIMIT_STORE ou LOGIN_ATTEMPTS_STORE = redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --- Rate limit (por IP) -----------------------------------------------------
# memory (1 instância) | redis (várias réplicas)
RATE_LIMIT_STORE=memory
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=40
# login e cadastro
AUTH_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_RPS=50
WEBHOOK_RATE_LIMIT_BURST=200

# --- Bloqueio progressivo de login (por e-mail) ------------------------------
# postgres | redis
LOGIN_ATTEMPTS_STORE=postgres
# falhas livres antes do 1º bloqueio
LOGIN_LOCKOUT_FREE_ATTEMPTS=5
# 1º bloqueio; dobra a cada nova falha
LOGIN_LOCKOUT_BASE=1m
LOGIN_LOCKOUT_MAX=30m
LOGIN_LOCKOUT_WINDOW=24h

# --- Verificação de telefone -------------------------------------------------
# Pepper do HMAC dos códigos (padrão: primeiro SESSION_SECRETS). Mín. 32 caracteres.
VERIFICATION_PEPPER=

# --- E-mail (confirmação de conta) -------------------------------------------
# true = transações, resumo e parcelamentos exigem e-mail confirmado (403 email_nao_verificado)
EMAIL_VERIFICATION_REQUIRED=true
# smtp = envia de verdade | log = só escreve no log (DEV)
EMAIL_PROVIDER=smtp
APP_NAME=QuantoDeu
# DEV com docker compose: Mailpit captura os e-mails -> http://localhost:8025
# (rodando a API fora do Docker use SMTP_HOST=localhost)
SMTP_HOST=mailpit
SMTP_PORT=1025
# starttls (porta 587) | tls (porta 465) | none (só DEV)
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=QuantoDeu <no-reply@quantodeu.local>
#
# PRODUÇÃO com Gmail / Google Workspace:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=starttls
#   SMTP_USERNAME=suaconta@seudominio.com.br
#   SMTP_PASSWORD=<senha de APP, 16 letras — a senha da conta é sempre recusada>
#   SMTP_FROM=QuantoDeu <suaconta@seudominio.com.br>
#
#   1. Ative a verificação em duas etapas na conta Google.
#   2. Gere a senha de app em myaccount.google.com/apppasswords e cole aqui
#      (com ou sem os espaços que o Google mostra).
#   3. SMTP_FROM tem que ser a própria conta ou um alias confirmado nela
#      (Gmail > Configurações > Contas > "Enviar e-mail como"). Com outro
#      endereço o Gmail reescreve o remetente sem avisar.
#   4. Confira antes de abrir para usuários:  make mail-test TO=voce@exemplo.com
#
#   Limite: ~500 destinatários/dia no Gmail comum e ~2.000 no Workspace. Passou
#   disso, a conta é suspensa por 24 h — para volume maior troque por um serviço
#   transacional (Resend, Brevo, SES), que também usa estas mesmas variáveis.
#
# Outros provedores:
#   Outlook/Microsoft 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_TLS=starttls
#   Amazon SES:            SMTP_HOST=email-smtp.<regiao>.amazonaws.com SMTP_PORT=587
#   Servidor próprio:      use host/porta/usuário do seu provedor de e-mail

# --- Argon2id (mínimo OWASP: 19 MiB, t=2, p=1) -------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# --- WhatsApp ----------------------------------------------------------------
# Liga o bot: webhook de mensagens + verificação de telefone. Desligado (padrão)
# essas rotas NÃO existem e nenhuma credencial de provedor é exigida — é assim
# que o v1 vai para produção. O bot entra no v2.
WHATSAPP_BOT_ENABLED=false
# Daqui para baixo só vale com WHATSAPP_BOT_ENABLED=true.
# evolution | zapi | twilio
WHATSAPP_PROVIDER=evolution
# Segredo exigido no webhook (header X-Webhook-Token, Authorization: Bearer ou ?token=)
WHATSAPP_WEBHOOK_SECRET=troque-pelo-segredo-do-webhook
# off      = não responde (verificação só pelo método "mensagem")
# log      = só escreve no log o que seria enviado (DEV: veja códigos no log)
# provider = envia de verdade pelo provedor configurado
WHATSAPP_REPLY_MODE=log
# true = só números verificados lançam pelo WhatsApp (recomendado)
# false = desliga a exigência (verificação continua implementada, só não é cobrada)
WHATSAPP_REQUIRE_VERIFIED_PHONE=true

EVOLUTION_BASE_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=quantodeu

ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://api.seudominio.com.br/api/v1/webhook/whatsapp

# --- Observabilidade ---------------------------------------------------------
# servidor separado de /metrics ("off" desliga)
METRICS_ADDR=:9091
# Bearer exigido em /metrics (obrigatório em produção se exposto)
METRICS_TOKEN=
# true com o profile "observability" (Jaeger)
OTEL_ENABLED=false
# OTLP/HTTP (no compose: http://jaeger:4318)
OTEL_ENDPOINT=http://localhost:4318
# 0..1
OTEL_SAMPLE_RATIO=1

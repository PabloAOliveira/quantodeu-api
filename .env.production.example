# ============================================================================
# QuantoDeu — produção (servidor de casa, Linux Mint + Docker)
#
#   cp .env.production.example .env      # e preencha o que está marcado
#   make check-config                    # confere antes de subir
#
# Gere cada segredo com:  openssl rand -base64 48
# ============================================================================

APP_ENV=production
APP_NAME=QuantoDeu
APP_TIMEZONE=America/Sao_Paulo
HTTP_ADDR=:8080

# --- Banco -------------------------------------------------------------------
# Só o compose usa estas três: a DATABASE_URL é montada a partir delas.
POSTGRES_DB=quantodeu
POSTGRES_USER=quantodeu
POSTGRES_PASSWORD=            # <-- senha do DONO das tabelas
APP_DB_USER=quantodeu_api
APP_DB_PASSWORD=              # <-- senha do usuário da API (o que sofre RLS)

# --- Sessão ------------------------------------------------------------------
# Assina os cookies. Trocar desloga todo mundo; a lista aceita chaves antigas
# só para verificar, o que permite rotacionar sem derrubar ninguém.
SESSION_SECRETS=              # <-- mínimo 32 caracteres
SESSION_STORE=postgres
SESSION_COOKIE_NAME=__Host-quantodeu_session
SESSION_TTL=168h              # validade absoluta, contada do login
SESSION_IDLE_TIMEOUT=72h      # derruba antes se ficar sem uso
SESSION_CLEANUP_PERIOD=1h
VERIFICATION_PEPPER=          # <-- mínimo 32 caracteres (códigos de verificação)

# --- HTTP --------------------------------------------------------------------
# O app é nativo e não usa CORS. Só preencha se um front web for consumir a API.
CORS_ALLOWED_ORIGINS=
# O túnel da Cloudflare entrega as requisições vindas da rede do Docker.
TRUSTED_PROXIES=172.16.0.0/12
# Swagger fechado em produção (o padrão em APP_ENV=production já é false).
DOCS_ENABLED=false
# Métricas desligadas: num servidor de casa não há Prometheus para raspar.
# Para ligar depois: METRICS_ADDR=:9091 e METRICS_TOKEN=<segredo>.
METRICS_ADDR=off

# --- E-mail (Gmail / Google Workspace) ---------------------------------------
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=                # <-- a conta Google
SMTP_PASSWORD=                # <-- senha de APP (16 letras), não a senha da conta
# Precisa ser a própria conta ou um alias confirmado nela ("Enviar e-mail como").
SMTP_FROM=QuantoDeu <          >

# --- Argon2id (mínimo OWASP: 19 MiB, t=2, p=1) -------------------------------
# Num PC antigo, meça: se o login ficar lento, baixe ARGON2_MEMORY_KIB para 32768.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# --- Rate limit e bloqueio de login ------------------------------------------
RATE_LIMIT_STORE=memory
LOGIN_ATTEMPTS_STORE=postgres

# --- WhatsApp ----------------------------------------------------------------
# v1 sem bot: o webhook e a verificação de telefone nem são registrados.
WHATSAPP_BOT_ENABLED=false

# --- Túnel da Cloudflare -----------------------------------------------------
# Token do conector (Zero Trust > Networks > Tunnels). Só é usado com
# `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
